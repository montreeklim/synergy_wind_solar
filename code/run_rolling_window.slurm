#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=40
#SBATCH --job-name=rolling_window
#SBATCH --output=output.%A_%a.rolling_window
#SBATCH --time=24:00:00
#SBATCH --mail-user=mj1v21@soton.ac.uk
#SBATCH --mail-type=END,FAIL
#SBATCH --array=0-27

# Rolling-window robustness study — battery optimisation only.
# Scenarios must already exist (generated by generate_scenarios.slurm).
#
# Recommended submission pattern:
#
#   for DAY in 271 301 332 362; do
#     SCEN_JOB=$(sbatch --export=ALL,FORECAST_DAY=$DAY \
#                       --parsable generate_scenarios.slurm)
#     for TOL in 0.01 0.05 0.10; do
#       sbatch --export=ALL,FORECAST_DAY=$DAY,TOL=$TOL \
#              --dependency=afterok:$SCEN_JOB \
#              run_rolling_window.slurm
#     done
#   done
#
# Total array jobs: 4 dates × 3 tolerances = 12 submissions × 28 tasks = 336 instances.

FORECAST_DAY=${FORECAST_DAY:-271}
TOL=${TOL:-0.05}

python parallel_battery_model_cap.py \
    --index $SLURM_ARRAY_TASK_ID \
    --tol   $TOL \
    --forecast_day $FORECAST_DAY
